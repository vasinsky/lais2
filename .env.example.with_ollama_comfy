# ==============================================================================
# LOCAL AI STUDIO - FULL STACK (APP + OLLAMA + COMFYUI)
# All services running inside Docker with dedicated volume mounts for models
# ==============================================================================

# Core Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
MONGO_PORT=27017
OLLAMA_PORT=11434
COMFY_PORT=8188

# Workspace & Storage Paths
PROJECTS_DIR=./projects
MONGO_URI=mongodb://mongo:27017/local_ai_studio

# Host paths for Ollama models & ComfyUI data
# Adjust these local host paths if your models reside elsewhere on disk
OLLAMA_MODELS_DIR=~/.ollama/models
COMFY_MODELS_DIR=./comfy_models
COMFY_OUTPUT_DIR=./comfy_output

# Internal Docker Network URLs (used by backend container)
OLLAMA_URL=http://ollama:11434
COMFY_URL=http://comfyui:8188

# Public URLs (used if accessed externally by client browser)
PUBLIC_OLLAMA_URL=http://localhost:11434
PUBLIC_COMFY_URL=http://localhost:8188

# Default Model Selection (fallback on initial load)
DEFAULT_CODER_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
TRANSLATOR_MODEL=dolphin-llama3:latest
VISION_MODEL=minicpm-v:latest
